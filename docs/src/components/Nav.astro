---
const pathname = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<nav class="site-nav">
  <a href="/" class="logo">
    <svg width="20" height="20" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M16 4 L28 10.5 L28 21.5 L16 28 L4 21.5 L4 10.5 Z" stroke="currentColor" stroke-width="2" fill="none"/>
      <circle cx="16" cy="16" r="3.5" fill="currentColor"/>
    </svg>
    DB Sync Docs
  </a>
  <ul class="nav-links">
    <li><a href="/" class={isActive('/') && pathname === '/' ? 'active' : ''}>Home</a></li>
    <li><a href="/installing" class={isActive('/installing') || isActive('/building') || isActive('/running') || isActive('/docker') || isActive('/configuration') || isActive('/schema') || isActive('/migrations') || isActive('/validation') || isActive('/manual') || isActive('/state') || isActive('/upgrading') || isActive('/interesting') || isActive('/command') || isActive('/smash') || isActive('/pool') || isActive('/community') || isActive('/hlint') || isActive('/release') || isActive('/troubleshooting') || isActive('/database') ? 'active' : ''}>Docs</a></li>
    <li><a href="/survey" class={isActive('/survey') && !pathname.startsWith('/survey/results') ? 'active' : ''}>Survey</a></li>
    <li><a href="/survey/results" class={isActive('/survey/results') ? 'active' : ''}>Dashboard</a></li>
  </ul>
</nav>
