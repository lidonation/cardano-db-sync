{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Standing survey lifecycle registry (B27)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "current", "surveys"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "current": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preview", "mainnet"],
      "properties": {
        "preview": {
          "anyOf": [
            {
              "$ref": "#/definitions/ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "mainnet": {
          "anyOf": [
            {
              "$ref": "#/definitions/ref"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "surveys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "surveyRef",
          "network",
          "kind",
          "owner",
          "definedEpoch",
          "endEpoch",
          "questions",
          "subsumes"
        ],
        "properties": {
          "surveyRef": {
            "$ref": "#/definitions/ref"
          },
          "network": {
            "enum": ["preview", "mainnet"]
          },
          "kind": {
            "enum": ["core", "supplementary"]
          },
          "owner": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "hash"],
            "properties": {
              "type": {
                "enum": ["key", "script"]
              },
              "hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{56}$"
              }
            }
          },
          "definedEpoch": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "endEpoch": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "cancelledEpoch": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "questions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 65536,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "optionCount": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            }
          },
          "evolvesFrom": {
            "$ref": "#/definitions/ref"
          },
          "subsumes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["question", "older", "kind"],
              "properties": {
                "question": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "older": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["surveyRef", "question"],
                  "properties": {
                    "surveyRef": {
                      "$ref": "#/definitions/ref"
                    },
                    "question": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  }
                },
                "kind": {
                  "enum": ["replaces", "supersedes"]
                },
                "optionMap": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["older", "newer"],
                    "properties": {
                      "older": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "newer": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "core"
                }
              }
            },
            "then": {
              "properties": {
                "endEpoch": {
                  "const": 2000
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "supplementary"
                }
              }
            },
            "then": {
              "required": ["evolvesFrom"]
            }
          }
        ]
      }
    }
  },
  "definitions": {
    "ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}#(0|[1-9][0-9]{0,4})$"
    }
  }
}
