{
  "name": "cardano-db-sync-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation and community site for cardano-db-sync",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "cross-env DOCS_PROFILE=dev docusaurus start",
    "build:dev": "cross-env DOCS_PROFILE=dev docusaurus build --out-dir build/dev",
    "build:prod": "cross-env DOCS_PROFILE=prod docusaurus build --out-dir build/prod",
    "build": "npm run build:dev && npm run build:prod",
    "serve:dev": "cross-env DOCS_PROFILE=dev docusaurus serve --dir build/dev",
    "clear": "docusaurus clear",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:baseurl": "node scripts/check-baseurl.mjs",
    "check:css": "node scripts/check-css-gates.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:token-lint": "node scripts/check-token-lint.mjs",
    "check:deps": "node scripts/check-dependencies.mjs",
    "check:audit": "node scripts/check-audit.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "tokens": "python3 design/tools/tokens-to-css.py design/tokens.source.json > src/css/tokens.css",
    "i18n:sources": "cross-env DOCS_PROFILE=prod docusaurus write-translations --locale en",
    "check:manifest": "node scripts/check-route-manifest.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:csp": "node scripts/check-csp.mjs",
    "check:budget": "node scripts/check-asset-budget.mjs",
    "test": "vitest run --coverage",
    "test:build": "vitest run --config vitest.build.config.mts",
    "test:components": "playwright test",
    "test:schema-db": "vitest run --config vitest.db.config.mts",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run check:baseurl && npm run check:css && npm run check:annotations && npm run check:config && npm run check:schema && npm run check:renames && npm run check:tokens && npm run check:token-lint && npm run check:deps && npm run check:audit && npm run check:i18n && npm run check:manifest && npm run test && npm run test:components && npm run test:switchers:built && npm run test:build && npm run test:landing:built && npm run test:chrome && npm run check:links && npm run check:csp && npm run check:budget",
    "check:annotations": "node scripts/check-annotations.mjs",
    "check:config": "node scripts/check-config.mjs",
    "check:schema": "node scripts/check-schema.mjs",
    "extract:schema": "node scripts/extract-schema.mjs",
    "check:renames": "node scripts/check-renames.mjs",
    "test:switchers:built": "playwright test --config playwright.built.config.ts",
    "test:chrome": "cross-env DBS_BUILT_PROFILE=dev DBS_BUILT_SKIP_BUILD=1 playwright test --config playwright.built.config.ts test/built-browser/chrome.spec.ts --output=test-results/chrome-dev && cross-env DBS_BUILT_PROFILE=prod DBS_BUILT_SKIP_BUILD=1 playwright test --config playwright.built.config.ts test/built-browser/chrome.spec.ts --output=test-results/chrome-prod",
    "test:landing:built": "playwright test --config playwright.landing-built.config.ts"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-common": "3.10.2",
    "@docusaurus/utils-common": "3.10.2",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.56.1",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "cross-env": "7.0.3",
    "eslint": "9.39.5",
    "js-yaml": "4.3.2",
    "playwright-core": "1.56.1",
    "postcss": "8.5.29",
    "postcss-selector-parser": "7.1.6",
    "prettier": "3.9.6",
    "typescript": "5.6.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.3"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  }
}
