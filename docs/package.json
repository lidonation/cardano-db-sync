{
  "name": "cardano-db-sync-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation and community site for cardano-db-sync",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "cross-env DOCS_PROFILE=dev docusaurus start",
    "build:dev": "cross-env DOCS_PROFILE=dev docusaurus build --out-dir build/dev",
    "build:prod": "cross-env DOCS_PROFILE=prod docusaurus build --out-dir build/prod",
    "build": "npm run build:dev && npm run build:prod",
    "serve:dev": "cross-env DOCS_PROFILE=dev docusaurus serve --dir build/dev",
    "clear": "docusaurus clear",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:baseurl": "node scripts/check-baseurl.mjs",
    "check:css": "node scripts/check-css-gates.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "tokens": "python3 design/tools/tokens-to-css.py design/tokens.source.json > src/css/tokens.css",
    "check:links": "node scripts/check-links.mjs",
    "check:budget": "node scripts/check-asset-budget.mjs",
    "test": "vitest run --coverage",
    "test:build": "vitest run --config vitest.build.config.ts",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run check:baseurl && npm run check:css && npm run check:tokens && npm run test && npm run test:build && npm run check:links && npm run check:budget"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@vitest/coverage-v8": "^2.1.8",
    "cross-env": "^7.0.3",
    "eslint": "^9.15.0",
    "prettier": "^3.4.0",
    "typescript": "~5.6.0",
    "typescript-eslint": "^8.16.0",
    "vitest": "^2.1.8"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  }
}
