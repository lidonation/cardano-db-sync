# Local docs dev overrides. Copy to docs/.env (git-ignored) and uncomment what you need:
#   cp .env.example .env
#
# docs/config/profiles.ts reads docs/.env for the dev profile only (DOCS_PROFILE=dev).
# Real environment variables take precedence over values in this file. The production
# profile ignores both overrides, and this example file is never read.

# Origin the dev site is served from, e.g. a preview host behind an HTTPS proxy.
# Must be an http(s) origin: no credentials, path, query or hash.
# Default: https://lidonation.github.io
# DOCS_DEV_URL=https://your-preview-host.example/

# Route prefix for the dev server (`npm start`, NODE_ENV=development) only; dev builds
# keep the published prefix. Must start and end with "/".
# Default: /cardano-db-sync/
# DOCS_DEV_BASE_URL=/
