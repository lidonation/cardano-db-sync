{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": ".cache/survey-tally",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["scripts/survey/**/*.ts"]
}
