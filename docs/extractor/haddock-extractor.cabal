cabal-version:      3.6
name:               haddock-extractor
version:            0.1.0
synopsis:           Extract Haddock annotations from Haskell sources with ghc-lib-parser
description:        The B07 extractor: parses cardano-db Haskell sources (never compiles
                    them) and writes the Haddock annotations into the committed JSON
                    artifact that the docs site consumes. See docs/extractor/README.md.
homepage:           https://github.com/lidonation/cardano-db-sync
bug-reports:        https://github.com/lidonation/cardano-db-sync/issues
license:            Apache-2.0
author:             Lido Nation
maintainer:         darlington@lidonation.com
category:           Development
build-type:         Simple
extra-source-files: test/fixtures/*.hs
                    test/golden/*.json

common warnings
  ghc-options: -Wall
  default-language: Haskell2010
  default-extensions:
    LambdaCase
    NamedFieldPuns
    OverloadedStrings
    RecordWildCards
    ScopedTypeVariables
    TypeApplications

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:
    HaddockExtract
    HaddockExtract.Model
    HaddockExtract.Parse
    HaddockExtract.Run
    HaddockExtract.Walk
  build-depends:
      base                  >=4.18 && <5
    , aeson                 >=2.1  && <2.3
    , bytestring            >=0.11 && <0.13
    , containers            >=0.6  && <0.8
    , directory             >=1.3  && <1.4
    , filepath              >=1.4  && <1.6
    , ghc-lib-parser        >=9.6  && <9.7
    , scientific            >=0.3  && <0.4
    , text                  >=1.2  && <2.2
    , vector                >=0.12 && <0.14

executable extract-haddock
  import:           warnings
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:
      base                  >=4.18 && <5
    , bytestring            >=0.11 && <0.13
    , directory             >=1.3  && <1.4
    , filepath              >=1.4  && <1.6
    , haddock-extractor
    , text                  >=1.2  && <2.2

test-suite golden-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Golden.hs
  build-depends:
      base                  >=4.18 && <5
    , bytestring            >=0.11 && <0.13
    , directory             >=1.3  && <1.4
    , filepath              >=1.4  && <1.6
    , haddock-extractor
    , text                  >=1.2  && <2.2


test-suite regression-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Regression.hs
  build-depends:
      base                  >=4.18 && <5
    , aeson                 >=2.1  && <2.3
    , ghc-lib-parser        >=9.6  && <9.7
    , haddock-extractor
    , text                  >=1.2  && <2.2
