# Docusaurus
/.docusaurus
/build

# Dependencies
/node_modules

# Test output
/coverage
/test-results
/playwright-report

# Misc
.DS_Store
*.log

# Crowdin source strings, written by `npm run i18n:sources`
/i18n/en

# Build-time repository activity cache
/.cache/repository-activity

# Build-time public roadmap cache
/.cache/roadmap

# Deterministic browser builds, separate from uploaded profiles
/.cache/browser-fixtures

# Local preview configuration (may contain secrets)
/.env

# Read-only CI parity report, retained as an artifact for B17
/doc-parity-report.md

# Compiled scheduled tally (no raw chain or pending text persisted)
/.cache/survey-tally
